# Optional AI Agent LLM Configuration
# If not set, the app runs using the built-in Offline Rule-Based AI Agent.

# Provider choices: auto | offline | gemini | openai | ollama
AI_PROVIDER=auto

# Google Gemini (if using gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI or OpenAI-compatible endpoint (e.g. OpenAI, OpenTyphoon)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Example for OpenTyphoon:
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.opentyphoon.ai/v1
# OPENAI_MODEL=typhoon-v2.5-30b-a3b-instruct

# Local Ollama (if using ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional SQLite database path override (default: data/audit_history.db)
# AUDIT_DB_PATH=data/audit_history.db
