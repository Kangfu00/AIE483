# Optional AI Agent LLM Configuration
# If not set, the app runs using the built-in Offline Rule-Based AI Agent.

# Provider choices: auto | offline | gemini | openai | ollama
AI_PROVIDER=auto

# Google Gemini (if using gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI or OpenAI-compatible endpoint (if using openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama (if using ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
